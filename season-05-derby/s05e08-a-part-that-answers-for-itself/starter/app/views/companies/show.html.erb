<% content_for :title, @company.code %>

<h1><%= @company.code %></h1>

<%# TODO: карточка дороги — фреймом: название, дата, «Править». Правка
          должна открываться на месте карточки, а не на всю страницу. %>
<p><%= @company.name %></p>

<% if @company.registered_on %>
  <p>В реестре с <%= @company.registered_on %>.</p>
<% end %>

<%# TODO: расчёты — не здесь. Таблица ниже переезжает на лист расчётов
          (settlements/index); сюда лист вклеивается фреймом по своему адресу
          и подгружается, когда до него дойдут глазами. Без Turbo на месте
          фрейма остаётся ссылка на тот же лист — и она обязана уводить всю
          страницу. %>
<% if @settlements.any? %>
  <%# Таблица — это утверждение о связях, а не о клетках (s02e02). Подпись
      говорит, о чём таблица; заголовок столбца — что в столбце; заголовок
      строки — о чём строка. Читающий вслух слышит «1891-09, сумма, £801 0s
      0d», а не три числа подряд. %>
  <table>
    <caption>Расчёты с дорогой <%= @company.code %></caption>
    <thead>
      <tr>
        <th scope="col">Месяц</th>
        <th scope="col">Сумма</th>
        <th scope="col">Состояние</th>
      </tr>
    </thead>
    <tbody>
      <%= render @settlements %>
    </tbody>
  </table>
<% else %>
  <p>Расчётов с дорогой ещё не было.</p>
<% end %>

<p><%= link_to "Книга перевозок", company_consignments_path(@company) %></p>

<p><%= link_to "Внести бланк этой дороги", new_consignment_path(company: @company.code) %></p>

<p><%= link_to "Править", edit_company_path(@company) %></p>

<%# Удаление — не ссылка, а форма: ссылка — это GET, а GET обещает ничего не
    менять. `button_to` делает форму с кнопкой и скрытым `_method=delete`. %>
<%= button_to "Убрать из реестра", company_path(@company), method: :delete,
              form: { data: { turbo_confirm: "Убрать дорогу #{@company.code} из реестра?" } } %>

<p><%= link_to "Весь реестр", companies_path %></p>
