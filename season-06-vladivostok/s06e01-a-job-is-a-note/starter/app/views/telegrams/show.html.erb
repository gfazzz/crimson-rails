<% content_for :title, "Телеграмма: #{@telegram.addressee}" %>

<h1>Телеграмма: <%= @telegram.addressee %></h1>

<dl>
  <dt>Состояние</dt>
  <dd><%= render "state", telegram: @telegram %></dd>
  <dt>Текст</dt>
  <dd><%= simple_format @telegram.body %></dd>
</dl>

<p><%= link_to "Все телеграммы", telegrams_path %></p>
