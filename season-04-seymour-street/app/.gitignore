# Временное и машинное — в репозиторий не идёт.
/.bundle
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/.keep

# База — работа проходящего курс. Собирается из миграций одной командой.
/storage/*
!/storage/.keep
/db/*.sqlite3
/db/*.sqlite3-*

/public/assets
.byebug_history
.env*
/app/assets/builds/*
!/app/assets/builds/.keep
